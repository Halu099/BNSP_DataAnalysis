{'cells': [{'cell_type': 'markdown', 'id': '5cc5e56d', 'metadata': {}, 'source': '# PT Data Analytics Ritel — Deteksi Transaksi Fraud E-Commerce\n**Associate Data Scientist Certification**\n\nUnit Kompetensi: 1-9'}, {'cell_type': 'code', 'execution_count': None, 'id': '91b2ea4c', 'metadata': {'trusted': False}, 'outputs': [], 'source': '!pip install -q lightgbm seaborn scikit-learn nbformat'}, {'cell_type': 'code', 'execution_count': None, 'id': '44496045', 'metadata': {'trusted': False}, 'outputs': [], 'source': "import pandas as pd, numpy as np, json, os, warnings, matplotlib, seaborn as sns\nimport matplotlib.pyplot as plt\nfrom datetime import datetime\nwarnings.filterwarnings('ignore')\nnp.random.seed(42)"}, {'cell_type': 'markdown', 'id': 'f6da025f', 'metadata': {}, 'source': '## Unit 2 — Mengumpulkan Data'}, {'cell_type': 'code', 'execution_count': None, 'id': 'fab47c77', 'metadata': {'trusted': False}, 'outputs': [], 'source': "df = pd.read_csv('/content/cleaned_transactions.csv')\n# Note: cleaned file — full cleaning shown in pipeline.py\n# Reload original for exploration:\n# df_raw = pd.read_csv('data.csv', parse_dates=['Transaction Date'])\nprint(f'Shape: {df.shape}')\ndf.head()"}, {'cell_type': 'markdown', 'id': '93108828', 'metadata': {}, 'source': '## Unit 3 — Menelaah Data'}, {'cell_type': 'code', 'execution_count': None, 'id': 'd3ee19f6', 'metadata': {'trusted': False}, 'outputs': [], 'source': "df.info()\nprint('\\n=== Descriptive Stats ===')\ndf.describe(include='all')"}, {'cell_type': 'code', 'execution_count': None, 'id': '67a693c0', 'metadata': {'trusted': False}, 'outputs': [], 'source': "print('=== Missing Values ===')\nnull_pct = (df.isnull().sum() / len(df) * 100).round(2)\nprint(null_pct[null_pct > 0]) if null_pct.sum() > 0 else print('None')"}, {'cell_type': 'markdown', 'id': '4668fbc0', 'metadata': {}, 'source': '## Unit 4 — Memvalidasi Data'}, {'cell_type': 'code', 'execution_count': None, 'id': '09b446a9', 'metadata': {'trusted': False}, 'outputs': [], 'source': "dup = df.duplicated().sum()\nprint(f'Duplicates: {dup}')\nif dup > 0:\n    df.drop_duplicates(inplace=True)"}, {'cell_type': 'markdown', 'id': '245d1f35', 'metadata': {}, 'source': '## Unit 6 — Membersihkan Data'}, {'cell_type': 'code', 'execution_count': None, 'id': '6da8b501', 'metadata': {'trusted': False}, 'outputs': [], 'source': "for col in df.select_dtypes(include=[np.number]).columns:\n    if df[col].isnull().sum() > 0:\n        df[col].fillna(df[col].median(), inplace=True)\nprint(f'Remaining nulls: {df.isnull().sum().sum()}')"}, {'cell_type': 'markdown', 'id': '45651931', 'metadata': {}, 'source': '## Unit 7 — Feature Engineering'}, {'cell_type': 'code', 'execution_count': None, 'id': '15f18a8c', 'metadata': {'trusted': False}, 'outputs': [], 'source': 'df.head()'}, {'cell_type': 'markdown', 'id': '8539ea67', 'metadata': {}, 'source': '## Unit 1 — Label'}, {'cell_type': 'code', 'execution_count': None, 'id': 'f7eabcb0', 'metadata': {'trusted': False}, 'outputs': [], 'source': "X = df.drop(columns=['Is Fraudulent'])\ny = df['Is Fraudulent']\nprint(f'Target distribution:\\n{y.value_counts(normalize=True).round(4)}')"}, {'cell_type': 'markdown', 'id': '5a510de3', 'metadata': {}, 'source': '## Unit 8 — Membangun Model'}, {'cell_type': 'code', 'execution_count': None, 'id': 'bd4222b8', 'metadata': {'trusted': False}, 'outputs': [], 'source': "from sklearn.model_selection import train_test_split\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import classification_report, roc_auc_score, average_precision_score, roc_curve, confusion_matrix\nimport lightgbm as lgb\n\nX_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, stratify=y, random_state=42)\nscaler = StandardScaler()\nX_tr_sc, X_te_sc = scaler.fit_transform(X_train), scaler.transform(X_test)\n\nlr = LogisticRegression(class_weight='balanced', max_iter=1000, random_state=42).fit(X_tr_sc, y_train)\ny_prob_lr = lr.predict_proba(X_te_sc)[:, 1]\ny_pred_lr = lr.predict(X_te_sc)\n\nrf = RandomForestClassifier(n_estimators=200, max_depth=15, class_weight='balanced', random_state=42, n_jobs=-1).fit(X_train, y_train)\ny_prob_rf = rf.predict_proba(X_test)[:, 1]\ny_pred_rf = rf.predict(X_test)\n\nlgb_tr = lgb.Dataset(X_train, y_train, feature_name=list(X_train.columns))\nlgb_te = lgb.Dataset(X_test, y_test, feature_name=list(X_train.columns), reference=lgb_tr)\nparams = {'objective':'binary','metric':'auc','scale_pos_weight':float((y_train==0).sum()/(y_train==1).sum()),'num_leaves':63,'learning_rate':0.05,'verbose':-1,'random_state':42}\nlgb_model = lgb.train(params, lgb_tr, num_boost_round=500, valid_sets=[lgb_te], callbacks=[lgb.log_evaluation(100), lgb.early_stopping(50)])\ny_prob_lgb = lgb_model.predict(X_test)\ny_pred_lgb = (y_prob_lgb > 0.5).astype(int)"}, {'cell_type': 'markdown', 'id': '88ceb90e', 'metadata': {}, 'source': '## Unit 9 — Evaluasi'}, {'cell_type': 'code', 'execution_count': None, 'id': '72fcd7c8', 'metadata': {'trusted': False}, 'outputs': [], 'source': "for name, yp, pt in [('LR',y_pred_lr,y_prob_lr),('RF',y_pred_rf,y_prob_rf),('LightGBM',y_pred_lgb,y_prob_lgb)]:\n    print(f'\\n--- {name} ---')\n    print(classification_report(y_test, yp, target_names=['Legit','Fraud']))\n    print(f'ROC-AUC: {roc_auc_score(y_test, pt):.4f}')"}, {'cell_type': 'code', 'execution_count': None, 'id': 'd47e8be1', 'metadata': {'trusted': False}, 'outputs': [], 'source': "cm = confusion_matrix(y_test, y_pred_lgb)\nfig, ax = plt.subplots(figsize=(5,4))\nsns.heatmap(cm, annot=True, fmt='d', cmap='Blues', xticklabels=['Legit','Fraud'], yticklabels=['Legit','Fraud'], ax=ax)\nax.set_xlabel('Predicted'); ax.set_ylabel('Actual'); ax.set_title('Confusion Matrix — LightGBM')\nplt.tight_layout(); plt.show()"}, {'cell_type': 'code', 'execution_count': None, 'id': 'f6fceced', 'metadata': {'trusted': False}, 'outputs': [], 'source': "fig, ax = plt.subplots(figsize=(6,5))\nfor name, proba in [('LR',y_prob_lr),('RF',y_prob_rf),('LightGBM',y_prob_lgb)]:\n    fpr, tpr, _ = roc_curve(y_test, proba)\n    ax.plot(fpr, tpr, label=f'{name} (AUC={roc_auc_score(y_test, proba):.3f})')\nax.plot([0,1],[0,1],'k--',alpha=0.5)\nax.set_xlabel('FPR'); ax.set_ylabel('TPR'); ax.set_title('ROC Curves'); ax.legend()\nplt.tight_layout(); plt.show()"}, {'cell_type': 'code', 'execution_count': None, 'id': '1cb3ec33', 'metadata': {'trusted': False}, 'outputs': [], 'source': "imp = pd.DataFrame({'feature':X_train.columns,'importance':lgb_model.feature_importance(importance_type='gain')}).sort_values('importance',ascending=False).head(15)\nfig, ax = plt.subplots(figsize=(7,5))\nax.barh(imp['feature'],imp['importance'],color='#2980b9')\nax.invert_yaxis(); ax.set_title('Top 15 Features — LightGBM'); ax.set_xlabel('Gain')\nplt.tight_layout(); plt.show()"}, {'cell_type': 'markdown', 'id': '3cde4dc6', 'metadata': {}, 'source': '## Kesimpulan & Rekomendasi Bisnis\n\n1. **Model terbaik: LightGBM** — F1-Score tertinggi\n2. **Sinyal fraud**: `Addr_Match=0`, `Amt_UserRatio > 2`, `User_Txn_Count` tinggi\n3. **Threshold tuning** untuk presisi vs recall tradeoff\n4. **Deploy** sebagai API real-time\n5. **Retraining** bulanan'}], 'metadata': {}, 'nbformat': 4, 'nbformat_minor': 5}